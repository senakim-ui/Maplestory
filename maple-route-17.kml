      <LineString><tessellate>1</tessellate><coordinates>-113.9928,51.1215,0 -79.383,43.651,0</coordinates></LineString></Placemark>
    <Placemark><name>10/5 ✈ 토론토→샬럿타운 2h10m</name><styleUrl>#flight</styleUrl>
      <LineString><tessellate>1</tessellate><coordinates>-79.383,43.651,0 -63.131,46.238,0</coordinates></LineString></Placemark>
    <Placemark><name>10/7 ✈ 샬럿타운→퀘벡 (몬트리올 경유·단일발권) 3h40m</name><styleUrl>#flight</styleUrl>
      <LineString><tessellate>1</tessellate><coordinates>-63.131,46.238,0 -73.567,45.501,0 -71.208,46.813,0</coordinates></LineString></Placemark>
    <Placemark><name>10/10 🚄 퀘벡→몬트리올 VIA Rail 3h</name><styleUrl>#train</styleUrl>
      <LineString><tessellate>1</tessellate><coordinates>-71.208,46.813,0 -72.55,46.35,0 -73.567,45.501,0</coordinates></LineString></Placemark>
    <Placemark><name>10/11 ✈ 몬트리올→뉴욕 LGA 1.5h</name><styleUrl>#flight</styleUrl>
      <LineString><tessellate>1</tessellate><coordinates>-73.567,45.501,0 -74.006,40.713,0</coordinates></LineString></Placemark>
    <Placemark><name>10/13 ✈ 뉴욕 JFK→인천 KE082 14h</name><styleUrl>#flightIntl</styleUrl>
      <LineString><tessellate>1</tessellate><coordinates>-73.7781,40.6413,0 126.4407,37.4602,0</coordinates></LineString></Placemark>
  </Folder>
</Document>
